          }
        },
        "title": "AddRepo",
        "type": "object"
      },
      "GateDecision": {
        "properties": {
          "choice": {
            "title": "Choice",
            "type": "string"
          }
        },
        "required": [
          "choice"
        ],
        "title": "GateDecision",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ResumeRun": {
        "properties": {
          "choice": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Decision for the gate the run waits at.",
            "title": "Choice"
          },
          "inputs": {
            "additionalProperties": true,
            "title": "Inputs",
            "type": "object"
          }
        },
        "title": "ResumeRun",
        "type": "object"
      },
      "StartRun": {
        "properties": {
          "feature": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Existing feature (NNN-name); default new.",
            "title": "Feature"
          },
          "inputs": {
            "additionalProperties": true,
            "title": "Inputs",
            "type": "object"
          },
          "workflow": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Workflow id (repo or built-in), or a file path; default: the configured default workflow (automated).",
